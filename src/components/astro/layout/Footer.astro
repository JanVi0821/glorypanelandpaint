---
import { business } from '../../../data/business';
import { images } from '../../../data/images';
import './footer.scss';

const year = new Date().getFullYear();

const tagline =
	'GLORY Panel & Paint is a leading provider of quality panel beating and paint services — from minor repairs to major panel and paint restorations. We strive for perfection and guarantee work that\u2019s high-quality, trustworthy and reliable, so you have peace of mind your vehicle is in the best hands.';
---

<footer class="glory-site-footer">
	<div class="glory-site-header__inner">
		<div class="glory-footer">
			<div class="glory-foot-brand">
				<img src={images.logo} class="glory-foot-logo" alt={business.name} width="120" height="54" />
				<p>{tagline}</p>
				<div class="glory-foot-social">
					<a href={business.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
							<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"></path>
						</svg>
					</a>
					<a href={business.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<rect x="2" y="2" width="20" height="20" rx="5"></rect>
							<circle cx="12" cy="12" r="4"></circle>
							<circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
				</div>
			</div>

			<div class="glory-foot-contact">
				<h3>Contact Us</h3>
				<div class="glory-foot-item">
					<span class="glory-foot-ic" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
							<rect x="3" y="5" width="18" height="14" rx="2"></rect>
							<path d="m3 7 9 6 9-6"></path>
						</svg>
					</span>
					<div>
						<small>Need body works?</small><br />
						<a href={`mailto:${business.email}`}>{business.email}</a>
					</div>
				</div>
				<div class="glory-foot-item">
					<span class="glory-foot-ic" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
							<circle cx="12" cy="10" r="3"></circle>
						</svg>
					</span>
					<div>
						<small>Visit our workshop</small><br />
						{business.address.full}
					</div>
				</div>
				<div class="glory-foot-item">
					<span class="glory-foot-ic" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
						</svg>
					</span>
					<div>
						<small>Call us today</small><br />
						<a href={`tel:${business.phoneTel}`}>{business.phone}</a>
						{' '}&middot;{' '}
						<a href={`tel:${business.mobileTel}`}>{business.mobile}</a> ({business.mobileContact})
					</div>
				</div>
			</div>

			<div class="glory-foot-hours">
				<h3>Opening Hours</h3>
				<ul>
					{
						business.hours.map((row) => (
							<li>
								<span>{row.days}</span>
								<b>{row.time}</b>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="glory-foot-bottom">
			&copy; {year} {business.name}, Hornby, Christchurch NZ. All rights reserved.
		</div>
	</div>
</footer>

<script is:inline>
  function setupPhoneCallTracking() {
    document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
      el.removeEventListener('click', el.__phPhoneHandler);
      el.__phPhoneHandler = function() {
        window.posthog?.capture('phone_call_clicked');
      };
      el.addEventListener('click', el.__phPhoneHandler);
    });
  }
  document.addEventListener('DOMContentLoaded', setupPhoneCallTracking);
  document.addEventListener('astro:page-load', setupPhoneCallTracking);
</script>
