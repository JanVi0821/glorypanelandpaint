---
import { business } from '../../../data/business';
---

<div class="glory-topbar" aria-label="Contact information">
	<span class="glory-tb-hours">
		We are open &middot; Mon&ndash;Fri 7:30am&ndash;5pm &middot; Sat 9am&ndash;5pm
	</span>
	<span class="glory-tb-divider" aria-hidden="true"></span>
	<a href={`tel:${business.phoneTel}`}>
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
		</svg>
		{business.phone}
	</a>
	<a href={`mailto:${business.email}`}>
		<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<rect x="3" y="5" width="18" height="14" rx="2"></rect>
			<path d="m3 7 9 6 9-6"></path>
		</svg>
		{business.email}
	</a>
</div>
