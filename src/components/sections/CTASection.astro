---
interface Props {
	title: string;
	subtitle?: string;
	buttonLabel: string;
	buttonHref: string;
	showMeta?: boolean;
}

const { title, subtitle, buttonLabel, buttonHref, showMeta = false } = Astro.props;
---

<section class="glory-section glory-cta glory-sunburst">
	<div class="glory-inner glory-center">
		<h2>{title}</h2>
		{subtitle && <p class="glory-sub" style="margin:10px auto 0;">{subtitle}</p>}
		<div class="glory-btns" style="justify-content:center;">
			<a class="glory-btn-gold" href={buttonHref}>{buttonLabel}</a>
			<slot name="extra-buttons" />
		</div>
		{
			showMeta && (
				<div class="glory-meta">
					<span class="glory-meta-part">13–15 Smarts Rd, Hornby, Christchurch</span>
					<span class="glory-meta-sep"> · </span>
					<span class="glory-meta-part">03 420 2022</span>
					<span class="glory-meta-sep"> · </span>
					<span class="glory-meta-part">Mon–Fri 7:30–5, Sat 9–5</span>
				</div>
			)
		}
		<slot />
	</div>
</section>
