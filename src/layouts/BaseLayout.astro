---
import { ClientRouter } from 'astro:transitions';
import type { PageSeo } from '../data/seo';
import { business } from '../data/business';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PromoPopup from '../components/react/PromoPopup';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '../styles/global.scss';
import '../components/sections/page-hero.scss';
import '../components/react/promo-popup.scss';

interface Props {
    seo: PageSeo;
    schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { seo, schema } = Astro.props;
const canonical = new URL(seo.path, business.url).href;
const ogImage = new URL('/images/og-image.jpg', business.url).href;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!doctype html>
<html lang="en-NZ">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />

        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/TacticRoundExd-MedIt.woff2"
            crossorigin
        />

        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={canonical} />
        {seo.noindex && <meta name="robots" content="noindex, follow" />}

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={business.name} />
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={seo.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content="en_NZ" />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${business.name} workshop in Hornby, Christchurch`} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:description" content={seo.description} />
        <meta name="twitter:image" content={ogImage} />

        {
            schemas.map((node) => (
                <script type="application/ld+json" set:html={JSON.stringify(node)} />
            ))
        }

		<!-- Google tag (gtag.js) — loads on production only -->
		{
		    import.meta.env.PROD && (
		        <>
		            <script>
						/* eslint-disable @typescript-eslint/ban-ts-comment -- GTM third-party snippet */
						// @ts-nocheck
						(function(w, d, s, l, i) {
						    w[l] = w[l] || [];
						    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
						    const f = d.getElementsByTagName(s)[0];
						    const j = d.createElement(s);
						    const dl = l != 'dataLayer' ? '&l=' + l : '';
						    j.async = true;
						    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
						    f.parentNode.insertBefore(j, f);
						})(window, document, 'script', 'dataLayer', 'GTM-WR3WC8FG');

						// ClientRouter turns navigation into SPA-style swaps, which GTM
						// can't see by itself. Push a virtual pageview on each navigation
						// (skip the first astro:page-load — GTM already tracks the landing).
						let gtmFirstLoad = true;
						document.addEventListener('astro:page-load', () => {
						    if (gtmFirstLoad) {
						        gtmFirstLoad = false;
						        return;
						    }
						    window.dataLayer.push({
						        event: 'virtual_pageview',
						        page_path: window.location.pathname,
						        page_title: document.title,
						    });
						});
		            </script>
		        </>
		    )
		}
    </head>
    <body>
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WR3WC8FG"
                height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
        <Header />
        <main id="main-content">
            <slot />
        </main>
        <Footer />
        <PromoPopup client:idle />
    </body>
</html>
