---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/astro/sections/PageHero.astro";
import GloryGoldText from "../../components/astro/GloryGoldText.astro";
import { getPageSeo } from "../../data/seo";
import { images } from "../../data/images";
import "./styles.scss";
---

<BaseLayout seo={getPageSeo("book-online")}>
  <div class="glory">
    <PageHero
      eyebrow="Insurance claims only"
      centered
      padding="padding:84px 24px 48px;"
    >
      <h1 style="margin:14px auto 0;">
        Book your <GloryGoldText text="insurance assessment" />
      </h1>
    </PageHero>

    <section class="glory-section glory-bg-black" style="padding-top:48px;">
      <div class="glory-inner" style="max-width:880px;">
        <div class="glory-bookcard">
          <div
            class="glory-bookcard-img"
            style={`background-image:url('${images.assessment}');`}
            role="img"
            aria-label="Vehicle assessment at GLORY Panel & Paint"
          >
          </div>
          <div class="glory-bookcard-body">
            <h2>Insurance Assessment Appointment</h2>
            <div class="glory-bookcard-meta">30 min</div>
            <a href="/book-appointment/" class="glory-btn-gold" id="book-online-btn">Book Now</a>
          </div>
        </div>
      </div>
    </section>
  </div>

<script is:inline>
  function setupBookOnlineBtn() {
    var btn = document.getElementById('book-online-btn');
    if (!btn) return;
    btn.removeEventListener('click', btn.__phHandler);
    btn.__phHandler = function() {
      window.posthog?.capture('book_now_clicked');
    };
    btn.addEventListener('click', btn.__phHandler);
  }
  document.addEventListener('DOMContentLoaded', setupBookOnlineBtn);
  document.addEventListener('astro:page-load', setupBookOnlineBtn);
</script>
</BaseLayout>
